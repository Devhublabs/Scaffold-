# Copy this file to `.env` to override the docker-compose development defaults.
# Everything here is OPTIONAL — the stack boots without a .env file.

# Secret used to sign JWTs in backend-node. Change this for anything non-local.
JWT_SECRET=dev-secret-change-me

# MongoDB connection string used by backend-node.
# Inside docker-compose, "mongo" is the service hostname.
MONGO_URI=mongodb://mongo:27017/scaffold

# Comma-separated browser origins allowed to call the Node/FastAPI services.
CORS_ORIGINS=http://localhost:5173

DAILY_API_KEY=your_daily_api_key_here

# Groq API key for the Co-Artist proportion extraction (https://console.groq.com/keys).
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model (default: openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# Browser-facing service URLs used by Vite.
VITE_SOCKET_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_AUTH_API_URL=http://localhost:4000
